{
  "name": "clearframe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first image metadata cleaner. Your photos never leave your device.",
  "license": "MIT",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "build:cloudflare": "nuxt generate --preset cloudflare_pages_static && node -e \"require('node:fs').rmSync('dist/_redirects', { force: true })\"",
    "deploy:cloudflare": "npx wrangler@4 deploy",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.141",
    "@nuxt/ui": "^3.3.7",
    "exifreader": "^4.47.0",
    "nuxt": "^3.21.11",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "~5.9",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.12"
  }
}
